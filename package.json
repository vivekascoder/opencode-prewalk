{
  "name": "opencode-prewalk",
  "version": "0.1.0",
  "description": "Prewalk for OpenCode 2: plan with GPT-5.6 Sol, then continue the same session with GPT-5.6 Luna after the first successful edit.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "install.sh",
    "headless.sh",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/**/*.test.ts",
    "verify": "bash -n install.sh headless.sh && npm run typecheck && npm test"
  },
  "keywords": [
    "opencode",
    "opencode2",
    "plugin",
    "prewalk",
    "ai"
  ],
  "author": "Vivek",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vivekascoder/opencode-prewalk.git"
  },
  "bugs": {
    "url": "https://github.com/vivekascoder/opencode-prewalk/issues"
  },
  "homepage": "https://github.com/vivekascoder/opencode-prewalk#readme",
  "dependencies": {
    "@opencode-ai/plugin": "beta"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  }
}
